    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.62.1",
    "react-router-hash-link": "^2.4.3",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "svgo": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vite-plugin-image-optimizer": "^2.0.3",
