# Supabase Configuration for BS weestoater
# These credentials are used by both the frontend (Vite) and backend services

# Project Details
PROJECT_NAME=weeCMS
PROJECT_ID=YOUR_SUPABASE_PROJECT_ID

# Supabase Connection (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Service Role Key (For admin/migration scripts only - DO NOT expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_URL=https://your-project.supabase.co

# Garmin Connect Integration
GARMIN_USERNAME=your-garmin-email@example.com
GARMIN_PASSWORD=your-garmin-password

# Strava OAuth Configuration (server-side only, used by scripts/sync-strava.js)
# Get credentials from: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id
# ⚠️ IMPORTANT: Never commit real credentials to git
# No VITE_ prefix: the secret must not be bundled into the browser
STRAVA_CLIENT_SECRET=your_strava_client_secret
# Obtained once via the OAuth code exchange (scope: read,activity:read_all)
STRAVA_REFRESH_TOKEN=your_strava_refresh_token
# Redirect URI must match what you configured in Strava settings
VITE_STRAVA_REDIRECT_URI=http://localhost:3000/strava/callback
