# Supabase Configuration for BS weestoater
# These credentials are used by both the frontend (Vite) and backend services

# Project Details
PROJECT_NAME=weeCMS
PROJECT_ID=YOUR_SUPABASE_PROJECT_ID

# Supabase Connection (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Service Role Key (For admin/migration scripts only - DO NOT expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_URL=https://your-project.supabase.co

# Garmin Connect Integration
GARMIN_USERNAME=your-garmin-email@example.com
GARMIN_PASSWORD=your-garmin-password

# Strava OAuth Configuration
# Get credentials from: https://www.strava.com/settings/api
VITE_STRAVA_CLIENT_ID=your_strava_client_id
VITE_STRAVA_CLIENT_SECRET=your_strava_client_secret
# Update redirect URI based on environment:
#   Development: http://localhost:3000/strava/callback
#   Production: https://your-domain.com/strava/callback
VITE_STRAVA_REDIRECT_URI=http://localhost:3000/strava/callback
