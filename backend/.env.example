# Supabase Configuration for BS WeeStaater
# Copy this file to .env and fill in your Supabase credentials

# For Vite projects (frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# For Node.js scripts (backend - optional, uses VITE_ vars if not set)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key for admin operations (keep secret!)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
